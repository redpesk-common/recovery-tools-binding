{
  "name": "recovery-app",
  "version": "1.1.6",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "version": "node set-git-tag.js",
    "set_version": "[ -z \"$VERSION\" ] && export VERSION=$(cat package.json | jq -r .version); sed -i -e \"s/GIT_TAG: .*$/GIT_TAG: '$VERSION'/g\" src/environments/environment.prod.ts",
    "build:prod": "npm run set_version && ng build --configuration production --aot",
    "build:dev": "npm run set_version && ng build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@angular/localize": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/platform-browser-dynamic": "^21.1.3",
    "@angular/router": "^21.1.3",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@popperjs/core": "^2.11.8",
    "@redpesk/afb-ws": "^1.0.1",
    "bootstrap": "^5.3.8",
    "file-saver-es": "^2.0.5",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.3",
    "@types/file-saver-es": "^2.0.3",
    "@types/jasmine": "~4.0.3",
    "@types/node": "^20.16.0",
    "jasmine-core": "~4.0.1",
    "jasmine-spec-reporter": "~5.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.2",
    "karma-jasmine-html-reporter": "^1.7.0",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.3",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "http-proxy-middleware": "^3.0.4"
  },
  "resolutions": {
    "http-proxy-middleware": "^3.0.4"
  }
}
